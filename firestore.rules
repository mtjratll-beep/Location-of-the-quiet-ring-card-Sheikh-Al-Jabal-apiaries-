// مناحل شيخ الجبل — Firestore Security Rules
// قبل النشر: استبدل admin@example.com ببريد حساب المدير الفعلي في Firebase Authentication.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == "admin@example.com"; }

    match /customers/{uid} {
      allow create, read, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
      allow list: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
