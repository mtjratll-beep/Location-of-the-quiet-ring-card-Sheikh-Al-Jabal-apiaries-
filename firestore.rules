// مناحل شيخ الجبل — Firestore Security Rules
// صلاحية المدير محددة بواسطة Firebase Authentication UID.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "E7BARYJCQ1RfX96My8uAmEt7jSA3";
    }

    // بيانات العملاء: العميل يصل إلى مستنده فقط، والمدير يستطيع عرض القائمة وإدارتها.
    match /customers/{uid} {
      allow create, get, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
    }

    // إعدادات الموقع وشعار الختم.
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
